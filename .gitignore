# Python & Virtual Environments
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so
.pytest_cache/
.coverage
htmlcov/
.tox/

# Local Database & SQLite files
*.db
*.sqlite
*.sqlite3
urbandhagaa.db
tools/


# Secrets & Environment variables (DO NOT COMMIT SECRETS)
.env
.env.local
backend/.env
frontend/.env
frontend/.env.local
*.pem
*.key

# Allow example env files (these are safe to commit)
!.env.example
!frontend/.env.example
!backend/.env.example

# Frontend Node & Vite build outputs
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
.vercel/
frontend/.vercel/

# Allow vercel.json configuration files (needed for deployment)
!vercel.json
!frontend/vercel.json


# Logs & Temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & System files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
